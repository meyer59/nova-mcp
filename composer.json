{
  "name": "meyer59/nova-mcp",
  "description": "An MCP server for Laravel Nova that connects AI assistants to Nova resources with existing authorization and per-token permissions.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.41.1 || ^13.0",
    "laravel/nova": "^5.7",
    "laravel/mcp": "^0.6.7 || ^0.7 || ^0.8 || ^0.9 || ^1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^10.8 || ^11.0",
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "NovaMcp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NovaMcp\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "NovaMcp\\NovaMcpServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=512M"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "keywords": [
    "laravel",
    "laravel-nova",
    "nova",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai"
  ],
  "homepage": "https://github.com/meyer59/nova-mcp",
  "support": {
    "source": "https://github.com/meyer59/nova-mcp",
    "issues": "https://github.com/meyer59/nova-mcp/issues"
  }
}
